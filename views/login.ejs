<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SGI - Entrar</title>
    <link rel="stylesheet" href="/css/stylesLogin.css">
</head>
<body>

    <main class="auth-container">
        <form class="auth-card" action="/login" method="POST">
            <h2>Acessar o SGI</h2>
            <p class="subtitle">Entre com suas credenciais do Grêmio</p>

            <div class="input-group">
                <label for="email">E-mail Institucional</label>
                <input type="email" id="email" name="email" placeholder="Ex: igs@aluno.ifal.edu.br" required>
            </div>

            <div class="input-group">
                <label for="senha">Senha</label>
                <input type="password" id="senha" name="senha" placeholder="••••••••" required>
            </div>

            <button type="submit" class="btn-submit">Entrar</button>

            <p class="auth-footer">
                Ainda não tem conta? <a href="/registro">Cadastre-se</a>
            </p>
        </form>
    </main>

</body>
</html>